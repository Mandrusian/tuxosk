#!/bin/sh
# Pick the on-screen keyboard phosh starts: osk-select tux | stevia | toggle | status
set -e
D="$HOME/.config/systemd/user/mobi.phosh.OSK.service.d"
if [ -n "${TUXOSK_BIN:-}" ]; then
  BIN="$TUXOSK_BIN"
elif [ -x "$HOME/.local/bin/tuxosk" ]; then
  BIN="$HOME/.local/bin/tuxosk"
else
  BIN="$(command -v tuxosk 2>/dev/null || true)"
fi
state() { [ -f "$D/tuxosk.conf" ] && echo tux || echo stevia; }
case "${1:-toggle}" in
  status) state; exit 0 ;;
  toggle) [ "$(state)" = tux ] && set -- stevia || set -- tux ;;
esac
case "$1" in
  tux)
    [ -n "$BIN" ] && [ -x "$BIN" ] || { echo "tuxosk not found (checked ~/.local/bin/tuxosk and PATH); set TUXOSK_BIN" >&2; exit 1; }
    mkdir -p "$D"
    printf '[Service]\nExecStart=\nExecStart=%s\n' "$BIN" > "$D/tuxosk.conf" ;;
  stevia) rm -f "$D/tuxosk.conf" ;;
  *) echo "usage: osk-select tux|stevia|toggle|status" >&2; exit 2 ;;
esac
systemctl --user daemon-reload
systemctl --user restart mobi.phosh.OSK.service
echo "keyboard: $(state)"
